            ".validate": "newData.isString() && newData.val().length <= 900000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
          },
          "version": {
            ".validate": "newData.isNumber() && newData.val() === 1"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "characterMasteryLeaderboard": {
      "v1": {
        "$characterId": {
          ".read": "auth != null",
          ".indexOn": [
            "xp"
          ],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['uid','characterId','nickname','xp','level','updatedAt','version']) && newData.child('uid').val() === auth.uid && newData.child('characterId').val() === $characterId && newData.child('version').val() === 1",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid && newData.val() === $uid && newData.val().length <= 128"
            },
            "characterId": {
              ".validate": "newData.isString() && newData.val() === $characterId && newData.val().length >= 1 && newData.val().length <= 64"
            },
            "nickname": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "xp": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 176155"
            },
            "level": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
            },
            "version": {
              ".validate": "newData.isNumber() && newData.val() === 1"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
